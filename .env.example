# Copy to .env and adjust. All TrustMeBro configuration is read exclusively
# by lib/identity (see Grobentwurf appendix: identity is the extension point
# for a later multi-user architecture).

# Short handle recorded as actor "human:<kuerzel>" in claim history entries.
TMB_ACTOR_KUERZEL=lg

# Root directory for project workspaces (one subdirectory per project).
TMB_WORKSPACE=./workspace

# Adapter layer (TMB-19) — all optional, code defaults shown. Operational
# tuning only; what actually happened per call is recorded in the trace log.
# Per-attempt child-process timeout for agent-CLI calls.
#TMB_ADAPTER_TIMEOUT_MS=300000
# Total attempts per job (first try + retries) before escalation.
#TMB_ADAPTER_MAX_ATTEMPTS=3
# Base of the exponential backoff between retries.
#TMB_ADAPTER_RETRY_BASE_DELAY_MS=2000
# Global cap on concurrent CLI child processes (protects the subscription).
#TMB_ADAPTER_MAX_CONCURRENCY=2
