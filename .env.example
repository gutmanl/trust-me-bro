# Copy to .env and adjust. Application settings are read exclusively by
# lib/identity, the single seam through which the application learns who is
# acting and where data lives; the two launcher settings at the end
# (TMB_PORT, TMB_NO_BROWSER) are read by the startup script instead.
#
# Anything set here takes precedence over the stored configuration and is
# shown as read-only in the interface — the application will not write a
# value the environment would immediately override.

# Short handle recorded as actor "human:<handle>" in claim history entries.
# Optional: normally set once in the setup wizard (/setup) and changeable
# later under Einstellungen, which stores it in the config file below.
TMB_ACTOR_HANDLE=lg

# Root directory for project workspaces (one subdirectory per project).
TMB_WORKSPACE=./workspace

# Stored configuration file. Default: ~/.trustmebro/config.json. It lives
# outside the workspace, because the workspace location is one of its
# answers. Override mainly for tests and packaged runs.
#TMB_CONFIG_PATH=./.local/config.json

# Unpaywall contact address for the reference auto-import — optional.
# Sent with every Unpaywall lookup as its required identification, used to
# derive a free PDF URL for DOI-only reference candidates. Normally set in
# the application itself (the setup wizard, Einstellungen, or inline in the
# reference-import panel), which stores it in the config file above.
# Absent entirely: the Unpaywall step is simply skipped, no error.
#TMB_UNPAYWALL_EMAIL=you@example.org

# API backend — optional, experimental, OFF by default. The application runs
# unchanged without these; only when the flag is "1" AND a key is present
# does the "anthropic-api" backend become selectable, and then only as a
# secondary backend. Note that this one is billed per token, unlike the
# subscription-based agent CLIs.
#TMB_ENABLE_API_BACKEND=1
#ANTHROPIC_API_KEY=sk-ant-...

# Adapter layer — all optional, code defaults shown. Operational
# tuning only; what actually happened per call is recorded in the trace log.
# Per-attempt child-process timeout for agent-CLI calls.
#TMB_ADAPTER_TIMEOUT_MS=300000
# Total attempts per job (first try + retries) before escalation.
#TMB_ADAPTER_MAX_ATTEMPTS=3
# Base of the exponential backoff between retries.
#TMB_ADAPTER_RETRY_BASE_DELAY_MS=2000
# Global cap on concurrent CLI child processes (protects the subscription).
#TMB_ADAPTER_MAX_CONCURRENCY=2

# Launcher only (read by the startup script, not by lib/identity).
# Start port for the local server; occupied ports are skipped. Default 4173.
#TMB_PORT=4173
# Set to 1 to keep the launcher from opening a browser window on start.
#TMB_NO_BROWSER=1
