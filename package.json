{
  "name": "trustmebro",
  "version": "0.4.0",
  "description": "A verification workshop for LLM-researched briefings: claims, frozen sources and a hash-chained, independently verifiable history.",
  "license": "MIT",
  "author": "Leonid Gutman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gutmanl/trust-me-bro.git"
  },
  "private": true,
  "bin": {
    "trustmebro": "bin/trustmebro.mjs",
    "tmb": "dist/cli/tmb.js"
  },
  "files": [
    "bin",
    "dist/cli",
    "dist/lib",
    ".next/standalone",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "corpus:seed": "tsx scripts/seed-corpus.ts",
    "corpus:record": "tsx scripts/record-corpus.ts",
    "corpus:fetch": "tsx scripts/fetch-corpus.ts",
    "test:browser": "playwright test",
    "test:browser:cold-start": "playwright test --config playwright.cold-start.config.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "package:build": "node scripts/package-build.mjs",
    "prepack": "npm run package:build",
    "tmb": "tsx cli/tmb.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "next": "16.3.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
