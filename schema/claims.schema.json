{
  "$defs": {
    "__schema0": {
      "pattern": "^proj_[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "__schema1": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "__schema10": {
      "additionalProperties": false,
      "properties": {
        "confidence_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "on_relation_not_supports": {
          "type": "boolean"
        }
      },
      "required": [
        "confidence_threshold",
        "on_relation_not_supports"
      ],
      "type": "object"
    },
    "__schema11": {
      "pattern": "^src_[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "__schema12": {
      "minLength": 1,
      "type": "string"
    },
    "__schema13": {
      "additionalProperties": false,
      "properties": {
        "auto_capture": {
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "doi",
                "arxiv",
                "url",
                "crossref_title"
              ],
              "type": "string"
            },
            "raw_text": {
              "minLength": 1,
              "type": "string"
            },
            "score": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "raw_text",
            "method"
          ],
          "type": "object"
        },
        "identifier_verified": {
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/__schema1"
            },
            "status": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "at"
          ],
          "type": "object"
        },
        "previous_snapshots": {
          "items": {
            "$ref": "#/$defs/__schema14"
          },
          "type": "array"
        },
        "snapshot": {
          "$ref": "#/$defs/__schema14"
        },
        "source_type": {
          "enum": [
            "peer_reviewed_publication",
            "preprint",
            "grey_literature",
            "vendor_documentation"
          ],
          "type": "string"
        }
      },
      "required": [
        "source_type"
      ],
      "type": "object"
    },
    "__schema14": {
      "additionalProperties": false,
      "properties": {
        "blob_path": {
          "$ref": "#/$defs/__schema3"
        },
        "retrieved_at": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema17"
        },
        "sha256": {
          "$ref": "#/$defs/__schema2"
        },
        "text_blob_path": {
          "$ref": "#/$defs/__schema15"
        },
        "text_extraction_error": {
          "$ref": "#/$defs/__schema16"
        }
      },
      "required": [
        "retrieved_at",
        "sha256",
        "blob_path",
        "revision"
      ],
      "type": "object"
    },
    "__schema15": {
      "$ref": "#/$defs/__schema3"
    },
    "__schema16": {
      "minLength": 1,
      "type": "string"
    },
    "__schema17": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "__schema18": {},
    "__schema19": {
      "enum": [
        "captured",
        "existence_checked",
        "prechecked",
        "auto_confirmed",
        "pending_adjudication",
        "confirmed",
        "contested",
        "revised",
        "discarded",
        "recheck_required"
      ],
      "type": "string"
    },
    "__schema2": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "__schema20": {
      "pattern": "^ev_[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "__schema21": {
      "enum": [
        "supports",
        "partially_supports",
        "contradicts",
        "not_relevant"
      ],
      "type": "string"
    },
    "__schema22": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/__schema24"
        },
        "at": {
          "$ref": "#/$defs/__schema1"
        },
        "decision": {
          "additionalProperties": false,
          "properties": {
            "categories": {
              "items": {
                "enum": [
                  "wording_not_in_source",
                  "claim_not_derivable",
                  "taken_out_of_context",
                  "source_not_trustworthy",
                  "source_outdated",
                  "other"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "duration_s": {
              "minimum": 0,
              "type": "number"
            },
            "reviewed_evidence_ids": {
              "items": {
                "$ref": "#/$defs/__schema20"
              },
              "type": "array"
            }
          },
          "required": [
            "categories",
            "reviewed_evidence_ids",
            "duration_s"
          ],
          "type": "object"
        },
        "from_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema19"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "$ref": "#/$defs/__schema2"
        },
        "prev_hash": {
          "$ref": "#/$defs/__schema2"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "additionalProperties": false,
          "properties": {
            "new_text": {
              "minLength": 1,
              "type": "string"
            },
            "previous_text": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "previous_text",
            "new_text"
          ],
          "type": "object"
        },
        "routing": {
          "enum": [
            "no_evidence",
            "existence_check_failed",
            "divergence",
            "negative_precheck",
            "spot_check",
            "escalated",
            "negative_relevance"
          ],
          "type": "string"
        },
        "seq": {
          "$ref": "#/$defs/__schema23"
        },
        "state_root": {
          "$ref": "#/$defs/__schema25"
        },
        "to_status": {
          "$ref": "#/$defs/__schema19"
        }
      },
      "required": [
        "seq",
        "at",
        "actor",
        "from_status",
        "to_status",
        "reason",
        "prev_hash",
        "hash"
      ],
      "type": "object"
    },
    "__schema23": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "__schema24": {
      "pattern": "^(human|system):[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "__schema25": {
      "$ref": "#/$defs/__schema2"
    },
    "__schema3": {
      "pattern": "^blobs\\/[0-9a-f]{2}\\/[0-9a-f]{64}\\.[a-z0-9]+$",
      "type": "string"
    },
    "__schema4": {
      "additionalProperties": false,
      "properties": {
        "adjudication_sample_rate": {
          "$ref": "#/$defs/__schema6"
        },
        "backends": {
          "$ref": "#/$defs/__schema8"
        },
        "max_repair_cycles": {
          "$ref": "#/$defs/__schema7"
        },
        "rubric_version": {
          "$ref": "#/$defs/__schema5"
        },
        "second_opinion": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "rubric_version",
        "adjudication_sample_rate",
        "backends"
      ],
      "type": "object"
    },
    "__schema5": {
      "minLength": 1,
      "type": "string"
    },
    "__schema6": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "__schema7": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "__schema8": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "$ref": "#/$defs/__schema9"
        },
        "secondary": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "primary"
      ],
      "type": "object"
    },
    "__schema9": {
      "additionalProperties": false,
      "properties": {
        "cli": {
          "minLength": 1,
          "type": "string"
        },
        "model_family": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "cli",
        "model_family"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "briefing_anchor": {
            "minLength": 1,
            "type": "string"
          },
          "calibration_result": {
            "enum": [
              "licensed",
              "weakened",
              "pending_adjudication"
            ],
            "type": "string"
          },
          "claim_type": {
            "enum": [
              "quantitative_finding",
              "comparative_statement",
              "effectiveness_statement",
              "recommendation"
            ],
            "type": "string"
          },
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "existence_check": {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "$ref": "#/$defs/__schema1"
                    },
                    "status": {
                      "enum": [
                        "passed",
                        "failed"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "at"
                  ],
                  "type": "object"
                },
                "id": {
                  "$ref": "#/$defs/__schema20"
                },
                "judgments": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "$ref": "#/$defs/__schema1"
                      },
                      "backend": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "confidence": {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      },
                      "model": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "reasoning": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "relation_type": {
                        "$ref": "#/$defs/__schema21"
                      }
                    },
                    "required": [
                      "backend",
                      "model",
                      "relation_type",
                      "confidence",
                      "reasoning",
                      "at"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "locator": {
                  "additionalProperties": {},
                  "properties": {
                    "page": {
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "section": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "relation_type": {
                  "$ref": "#/$defs/__schema21"
                },
                "source_id": {
                  "$ref": "#/$defs/__schema11"
                },
                "verbatim_excerpt": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "source_id",
                "locator",
                "verbatim_excerpt",
                "judgments"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "history": {
            "items": {
              "$ref": "#/$defs/__schema22"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^clm_[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "extracted_at": {
                "$ref": "#/$defs/__schema1"
              },
              "model": {
                "minLength": 1,
                "type": "string"
              },
              "origin_project_id": {
                "$ref": "#/$defs/__schema0"
              },
              "search_path": {
                "minLength": 1,
                "type": "string"
              },
              "tool": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "tool",
              "model",
              "extracted_at",
              "search_path"
            ],
            "type": "object"
          },
          "status": {
            "$ref": "#/$defs/__schema19"
          },
          "support_degree": {
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "uncertain"
            ],
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "claim_type",
          "status",
          "briefing_anchor",
          "provenance",
          "evidence",
          "history"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "config": {
      "$ref": "#/$defs/__schema4"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "briefing_import": {
          "additionalProperties": false,
          "properties": {
            "blob_path": {
              "$ref": "#/$defs/__schema3"
            },
            "imported_at": {
              "$ref": "#/$defs/__schema1"
            },
            "sha256": {
              "$ref": "#/$defs/__schema2"
            },
            "tool": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "imported_at",
            "sha256",
            "blob_path",
            "tool"
          ],
          "type": "object"
        },
        "created_at": {
          "$ref": "#/$defs/__schema1"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "reference_scan": {
          "additionalProperties": false,
          "properties": {
            "blob_path": {
              "$ref": "#/$defs/__schema3"
            },
            "candidate_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "method": {
              "enum": [
                "regex",
                "regex+llm"
              ],
              "type": "string"
            },
            "scanned_at": {
              "$ref": "#/$defs/__schema1"
            },
            "sha256": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "scanned_at",
            "sha256",
            "blob_path",
            "method",
            "candidate_count"
          ],
          "type": "object"
        },
        "research_question": {
          "minLength": 1,
          "type": "string"
        },
        "source_set_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "research_question",
        "created_at",
        "source_set_revision"
      ],
      "type": "object"
    },
    "project_events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "$ref": "#/$defs/__schema24"
          },
          "at": {
            "$ref": "#/$defs/__schema1"
          },
          "config_change": {
            "additionalProperties": false,
            "properties": {
              "next": {
                "$ref": "#/$defs/__schema4"
              },
              "previous": {
                "$ref": "#/$defs/__schema4"
              }
            },
            "required": [
              "previous",
              "next"
            ],
            "type": "object"
          },
          "event": {
            "enum": [
              "project_created",
              "briefing_imported",
              "source_set_frozen",
              "source_set_revised",
              "batch_run_started",
              "batch_run_completed",
              "verification_run_started",
              "verification_run_completed",
              "relevance_run_started",
              "relevance_run_completed",
              "config_changed",
              "content_updated",
              "reference_scan_started",
              "reference_scan_completed"
            ],
            "type": "string"
          },
          "hash": {
            "$ref": "#/$defs/__schema2"
          },
          "prev_hash": {
            "$ref": "#/$defs/__schema2"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "seq": {
            "$ref": "#/$defs/__schema23"
          },
          "state_root": {
            "$ref": "#/$defs/__schema25"
          }
        },
        "required": [
          "seq",
          "at",
          "actor",
          "event",
          "reason",
          "prev_hash",
          "hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/__schema18"
        },
        "description": "CSL-JSON item with workshop extension in `custom`",
        "properties": {
          "custom": {
            "$ref": "#/$defs/__schema13"
          },
          "id": {
            "$ref": "#/$defs/__schema11"
          },
          "type": {
            "$ref": "#/$defs/__schema12"
          }
        },
        "required": [
          "id",
          "type",
          "custom"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project",
    "config",
    "sources",
    "claims",
    "project_events"
  ],
  "type": "object"
}
