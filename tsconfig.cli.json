{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "cli/tmb.ts",
    "cli/verify.ts",
    "lib/register/**/*.ts",
    "lib/export/**/*.ts",
    "lib/identity/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/__fixtures__/**"]
}
